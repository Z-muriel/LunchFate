@inherits LunchFateComponentBase

@* 卡片（.nb-card）：白底 + 3px 黑边 + 4px 硬阴影；卡片头为明黄底 + 下粗黑边。
   替代 Blazorise <Card> 的裸用，避免各页面自行拼装出不一致的头部与内边距。 *@

<div class="@CssClass">
    @if (Title is not null || TitleContent is not null || Actions is not null)
    {
        <div class="nb-card__header">
            <div>
                @if (TitleContent is not null)
                {
                    @TitleContent
                }
                else if (Title is not null)
                {
                    <h3 class="nb-card__title">@Title</h3>
                }

                @if (Subtitle is not null)
                {
                    <p class="nb-card__subtitle">@Subtitle</p>
                }
            </div>

            @if (Actions is not null)
            {
                <div class="nb-card__actions">@Actions</div>
            }
        </div>
    }

    <div class="nb-card__body">@ChildContent</div>

    @if (Footer is not null)
    {
        <div class="nb-card__footer">@Footer</div>
    }
</div>

@code {
    /// <summary>卡片标题文本；需要富标记时改用 <see cref="TitleContent"/>。</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>富标记标题；与 <see cref="Title"/> 同时提供时优先生效。</summary>
    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    /// <summary>标题下的补充说明。</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>卡片头右侧的操作区（按钮等）。</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>卡片主体内容。</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>卡片底部操作区；提供时才渲染底栏。</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>附加 CSS 类，供调用方微调外边距等。</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>拼装最终类名。</summary>
    private string CssClass => NbCss.Join("nb-card", Class);
}
