@inherits LunchFateComponentBase

@* 按钮（.nb-btn）：统一 3px 黑边 + 零模糊硬阴影 + hover 抬起 / active 按下。
   替代页面里裸写的 <button class="btn ...">，保证交互位移与焦点环全站一致。
   变体色语义固定，见 NbColor 的注释。 *@

<button type="@Type"
        class="@CssClass"
        disabled="@Disabled"
        @onclick="ClickedAsync">
    @if (!string.IsNullOrWhiteSpace(Icon) && Icon!.StartsWith("fa", StringComparison.Ordinal))
    {
        <i class="@Icon nb-btn__icon" aria-hidden="true"></i>
    }
    @ChildContent
</button>

@code {
    /// <summary>语义色；决定背景色，禁止跨语义借用。</summary>
    [Parameter]
    public NbColor Color { get; set; } = NbColor.Neutral;

    /// <summary>尺寸档位；Small 用于表格行内与工具栏。</summary>
    [Parameter]
    public NbSize Size { get; set; } = NbSize.Medium;

    /// <summary>原生 button 的 type 属性；表单提交按钮须传 submit。</summary>
    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>是否禁用；禁用时降低不透明度并锁定阴影。</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>是否占满父容器宽度。</summary>
    [Parameter]
    public bool Block { get; set; }

    /// <summary>FontAwesome 图标类名，如 fas fa-store；非 fa 开头时不渲染。</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>附加 CSS 类，供调用方微调间距等。</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>点击回调。</summary>
    [Parameter]
    public EventCallback Clicked { get; set; }

    /// <summary>按钮内容。</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>拼装最终类名：基础类 + 语义色 + 尺寸 + 块级 + 调用方附加类。</summary>
    private string CssClass => NbCss.Join(
        "nb-btn",
        NbCss.Modifier("nb-btn", NbCss.ColorName(Color)),
        Size switch
        {
            NbSize.Small => "nb-btn--sm",
            NbSize.Large => "nb-btn--lg",
            _ => null
        },
        Block ? "nb-btn--block" : null,
        Class);

    /// <summary>
    /// 转发点击事件；禁用状态下不触发回调。
    /// </summary>
    private Task ClickedAsync() => Disabled ? Task.CompletedTask : Clicked.InvokeAsync();
}
