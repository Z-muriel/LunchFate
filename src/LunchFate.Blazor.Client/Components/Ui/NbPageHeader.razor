@inherits LunchFateComponentBase

@* 页面标题区（.nb-page-header）：大号标题 + 副标题 + 右侧操作区，
   底部一条 3px 黑边把标题与内容分开。 *@

<header class="@CssClass">
    <div class="nb-page-header__text">
        <h1 class="nb-page-header__title">@Title</h1>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="nb-page-header__subtitle">@Subtitle</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="nb-page-header__actions">@Actions</div>
    }
</header>

@code {
    /// <summary>页面标题。</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    /// <summary>副标题 / 一句话说明，可为空。</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>右侧操作区（主按钮等）。</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>附加 CSS 类。</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>拼装最终类名。</summary>
    private string CssClass => NbCss.Join("nb-page-header", Class);
}
