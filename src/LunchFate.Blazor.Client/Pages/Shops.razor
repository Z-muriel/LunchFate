@page "/shops"
@attribute [Authorize(LunchFatePermissions.Shops.Default)]
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using LunchFate.Permissions
@using LunchFate.Shops
@using Microsoft.AspNetCore.Authorization
@using Volo.Abp.Authorization
@inject IShopAppService ShopAppService
@inherits LunchFateComponentBase

@* 店铺管理（需求文档 FR-S-01 ~ FR-S-05） *@

<Card>
    <CardHeader>
        <Row Class="justify-content-between">
            <Column ColumnSize="ColumnSize.IsAuto">
                <CardTitle>@L["Shops"]</CardTitle>
            </Column>
            <Column ColumnSize="ColumnSize.IsAuto">
                @if (_canCreate)
                {
                    <button type="button" class="btn btn-primary" @onclick="OpenCreateModal">
                        @L["NewShop"]
                    </button>
                }
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        @* 筛选区（需求文档 FR-S-01） *@
        <Row Class="mb-3">
            <Column ColumnSize="ColumnSize.Is3">
                <label class="form-label">@L["Keyword"]</label>
                <input type="text" class="form-control" @bind="_keyword" @bind:event="oninput" />
            </Column>
            <Column ColumnSize="ColumnSize.Is3">
                <label class="form-label">@L["Category"]</label>
                <select class="form-select" @bind="_filterCategory">
                    <option value="">@L["AnyCategory"]</option>
                    @foreach (var category in Enum.GetValues<ShopCategory>())
                    {
                        <option value="@((int)category)">@CategoryText(category)</option>
                    }
                </select>
            </Column>
            <Column ColumnSize="ColumnSize.Is3">
                <label class="form-label">@L["Status"]</label>
                <select class="form-select" @bind="_filterEnabled">
                    <option value="">@L["All"]</option>
                    <option value="true">@L["Enabled"]</option>
                    <option value="false">@L["Disabled"]</option>
                </select>
            </Column>
            <Column ColumnSize="ColumnSize.Is3" Class="d-flex align-items-end gap-2">
                <button type="button" class="btn btn-primary" @onclick="SearchAsync">@L["Search"]</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetFiltersAsync">@L["Reset"]</button>
            </Column>
        </Row>

        @if (_canCreate)
        {
            <NearbyShopSearch AllowBatchAdd="true" BatchAdded="ReloadAsync" />
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        @if (!string.IsNullOrEmpty(_notice))
        {
            <div class="alert alert-info">@_notice</div>
        }

        @* 批量操作工具栏（需求文档 FR-S-06）：勾选跨页累计，"全选本页"只作用于当前页 *@
        @if (_canEdit)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <span class="small text-muted">@L["Shops:BatchSelectedCount", _selectedIds.Count]</span>
                    <label class="small mb-0">
                        <input type="checkbox" checked="@AllPageSelected" @onchange="ToggleSelectPageAsync" />
                        @L["Shops:BatchSelectPage"]
                    </label>
                    <button type="button"
                            class="btn btn-sm btn-link p-0"
                            disabled="@(_selectedIds.Count == 0 || _batchBusy)"
                            @onclick="ClearSelectionAsync">
                        @L["Shops:BatchClearSelection"]
                    </button>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-success"
                            disabled="@(_selectedIds.Count == 0 || _batchBusy)"
                            @onclick="() => AskBatchSetEnabledAsync(true)">
                        @L["Shops:BatchEnable"]
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@(_selectedIds.Count == 0 || _batchBusy)"
                            @onclick="() => AskBatchSetEnabledAsync(false)">
                        @L["Shops:BatchDisable"]
                    </button>
                </div>
            </div>
        }

        @* 服务端分页：ReadData 每次翻页/排序回调，由应用服务完成筛选、计数、排序与分页 *@
        <DataGrid TItem="ShopDto"
                  @ref="@_grid"
                  Data="@_items"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="@_total"
                  ShowPager="true"
                  PageSize="10"
                  Responsive="true">
            <DataGridColumns>
                @* 选择列：跨页累计勾选，供批量启用/停用使用（需求文档 FR-S-06） *@
                <DataGridColumn TItem="ShopDto" Caption="">
                    <DisplayTemplate>
                        @if (_canEdit)
                        {
                            <input type="checkbox"
                                   class="form-check-input"
                                   aria-label="@L["Shops:SelectRow"]"
                                   checked="@IsSelected(context.Item)"
                                   @onchange="() => ToggleSelectedAsync(context.Item)" />
                        }
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ShopDto"
                                Field="@nameof(ShopDto.Name)"
                                Caption="@L["Name"]"
                                Sortable="true" />
                <DataGridColumn TItem="ShopDto"
                                Field="@nameof(ShopDto.Category)"
                                Caption="@L["Category"]">
                    <DisplayTemplate>
                        @CategoryText(context.Item.Category)
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ShopDto"
                                Field="@nameof(ShopDto.AveragePrice)"
                                Caption="@L["AveragePrice"]"
                                Sortable="true">
                    <DisplayTemplate>
                        @context.Item.AveragePrice.ToString("0.##")
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ShopDto"
                                Field="@nameof(ShopDto.Rating)"
                                Caption="@L["Rating"]"
                                Sortable="true">
                    <DisplayTemplate>
                        @(context.Item.Rating.HasValue ? context.Item.Rating.Value.ToString("0.0") : "-")
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ShopDto"
                                Field="@nameof(ShopDto.Address)"
                                Caption="@L["Address"]" />
                <DataGridColumn TItem="ShopDto" Caption="@L["Map"]">
                    <DisplayTemplate>
                        @if (context.Item.Longitude.HasValue && context.Item.Latitude.HasValue)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenMapModal(context.Item)">
                                @L["ViewMap"]
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ShopDto"
                                Field="@nameof(ShopDto.IsEnabled)"
                                Caption="@L["Status"]">
                    <DisplayTemplate>
                        @if (context.Item.IsEnabled)
                        {
                            <span class="badge text-bg-success">@L["Enabled"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@L["Disabled"]</span>
                        }
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridEntityActionsColumn TItem="ShopDto" @ref="@_actionsColumn">
                    <DisplayTemplate>
                        @* 操作按钮按权限隐藏：无权限用户不应看到必然失败的入口 *@
                        <EntityActions TItem="ShopDto" EntityActionsColumn="@_actionsColumn">
                            @if (_canEdit)
                            {
                                <EntityAction TItem="ShopDto"
                                              Text="@L["Edit"]"
                                              Clicked="() => OpenEditModal(context.Item)" />
                                <EntityAction TItem="ShopDto"
                                              Text="@(context.Item.IsEnabled ? L["Disabled"] : L["Enabled"])"
                                              Clicked="() => ToggleEnabled(context.Item)" />
                            }
                            @if (_canDelete)
                            {
                                <EntityAction TItem="ShopDto"
                                              Text="@L["Delete"]"
                                              Clicked="() => AskDelete(context.Item)" />
                            }
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

@* 新增 / 编辑弹窗 *@
<Modal @ref="@_formModal" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@(_isEdit ? L["Edit"] : L["NewShop"])</ModalTitle>
            <CloseButton Clicked="CloseFormModal" />
        </ModalHeader>
        <EditForm Model="@_entity" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ModalBody>
                @if (_formError != null)
                {
                    <div class="alert alert-danger">@_formError</div>
                }
                <div class="mb-3">
                    <label class="form-label">@L["Name"]</label>
                    <input type="text" class="form-control" maxlength="@ShopConsts.MaxNameLength" @bind="_entity.Name" />
                    <ValidationMessage For="@(() => _entity.Name)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Category"]</label>
                    <select class="form-select" @bind="_entity.Category">
                        @foreach (var category in Enum.GetValues<ShopCategory>())
                        {
                            <option value="@category">@CategoryText(category)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["AveragePrice"]</label>
                    <input type="number" min="0" step="0.5" class="form-control" @bind="_entity.AveragePrice" />
                    <ValidationMessage For="@(() => _entity.AveragePrice)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Rating"]</label>
                    <input type="number" min="1" max="5" step="0.5" class="form-control" @bind="_entity.Rating" />
                    <ValidationMessage For="@(() => _entity.Rating)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Address"]</label>
                    <input type="text" class="form-control" maxlength="@ShopConsts.MaxAddressLength" @bind="_entity.Address" />
                    <ValidationMessage For="@(() => _entity.Address)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Phone"]</label>
                    <input type="text" class="form-control" maxlength="@ShopConsts.MaxPhoneLength" @bind="_entity.Phone" />
                    <ValidationMessage For="@(() => _entity.Phone)" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Tags"]</label>
                    <input type="text" class="form-control" placeholder="," @bind="_entity.Tags" />
                    <ValidationMessage For="@(() => _entity.Tags)" />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="_shopEnabled" @bind="_entity.IsEnabled" />
                    <label class="form-check-label" for="_shopEnabled">@L["IsEnabled"]</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">@L["Remark"]</label>
                    <input type="text" class="form-control" maxlength="@ShopConsts.MaxRemarkLength" @bind="_entity.Remark" />
                    <ValidationMessage For="@(() => _entity.Remark)" />
                </div>
            </ModalBody>
            <ModalFooter>
                <button type="button" class="btn btn-secondary" @onclick="CloseFormModal">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
            </ModalFooter>
        </EditForm>
    </ModalContent>
</Modal>

@* 店铺地图弹窗（需求文档 FR-M-06） *@
<Modal @ref="@_mapModal" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@_mapItem?.Name</ModalTitle>
            <CloseButton Clicked="CloseMapModal" />
        </ModalHeader>
        <ModalBody>
            @if (_mapItem != null)
            {
                <ShopMap Longitude="@_mapItem.Longitude"
                         Latitude="@_mapItem.Latitude"
                         Name="@_mapItem.Name"
                         Address="@_mapItem.Address" />
            }
        </ModalBody>
    </ModalContent>
</Modal>

@* 批量启用/停用二次确认弹窗（需求文档 FR-S-06） *@
<Modal @ref="@_batchModal" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@BatchActionText</ModalTitle>
            <CloseButton Clicked="CloseBatchModal" />
        </ModalHeader>
        <ModalBody>
            <p class="mb-0">@BatchConfirmText</p>
        </ModalBody>
        <ModalFooter>
            <button type="button" class="btn btn-secondary" @onclick="CloseBatchModal">@L["Cancel"]</button>
            <button type="button"
                    class="@BatchConfirmButtonClass"
                    disabled="@_batchBusy"
                    @onclick="BatchSetEnabledAsync">
                @BatchActionText
            </button>
        </ModalFooter>
    </ModalContent>
</Modal>

@* 删除二次确认弹窗（需求文档 FR-S-04） *@
<Modal @ref="@_deleteModal" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@L["Delete"]</ModalTitle>
            <CloseButton Clicked="CloseDeleteModal" />
        </ModalHeader>
        <ModalBody>
            <p class="mb-0">@string.Format(L["ShopDeletionConfirmationMessage"].Value, _deletingItem?.Name)</p>
        </ModalBody>
        <ModalFooter>
            <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">@L["Cancel"]</button>
            <button type="submit" class="btn btn-danger" @onclick="DeleteAsync">@L["Delete"]</button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private IReadOnlyList<ShopDto> _items = Array.Empty<ShopDto>();
    private int _total;
    private string? _keyword;
    private string _filterCategory = "";
    private string _filterEnabled = "";
    private string? _error;

    private DataGrid<ShopDto>? _grid;
    private Modal? _formModal;
    private Modal? _deleteModal;
    private Modal? _mapModal;
    private Modal? _batchModal;
    private DataGridEntityActionsColumn<ShopDto>? _actionsColumn;

    /// <summary>跨页累计的已选门店标识；批量启用/停用按此集合提交（需求文档 FR-S-06）。</summary>
    private readonly HashSet<Guid> _selectedIds = [];

    /// <summary>批量操作进行中标记，用于禁用按钮防止重复提交。</summary>
    private bool _batchBusy;

    /// <summary>批量操作的目标启用状态：true 为启用，false 为停用。</summary>
    private bool _batchTargetEnabled;

    /// <summary>批量操作结果提示（已更新 / 已是目标状态 / 未找到 三类计数）。</summary>
    private string? _notice;

    /// <summary>当前弹窗是否为编辑模式；false 表示新增。</summary>
    private bool _isEdit;

    /// <summary>编辑目标店铺 Id，新增模式下为 <see cref="Guid.Empty"/>。</summary>
    private Guid _editingId;

    private CreateUpdateShopDto _entity = new();

    /// <summary>新增/编辑弹窗内的业务错误提示（服务端返回），null 表示无错误。</summary>
    private string? _formError;

    /// <summary>待确认删除的店铺，null 表示删除弹窗未激活。</summary>
    private ShopDto? _deletingItem;

    /// <summary>当前地图弹窗展示的店铺。</summary>
    private ShopDto? _mapItem;

    /// <summary>是否拥有新增店铺权限；用于隐藏"新增店铺"按钮。</summary>
    private bool _canCreate;

    /// <summary>是否拥有编辑店铺权限；用于隐藏编辑/启停操作。</summary>
    private bool _canEdit;

    /// <summary>是否拥有删除店铺权限；用于隐藏删除操作。</summary>
    private bool _canDelete;

    /// <summary>当前页是否已全部选中；无数据时为 false，避免空列表显示"已全选"。</summary>
    private bool AllPageSelected => _items.Count > 0 && _items.All(IsSelected);

    /// <summary>批量操作的动作文案，同时用于确认弹窗标题与确认按钮。</summary>
    private string BatchActionText =>
        (_batchTargetEnabled ? L["Shops:BatchEnable"] : L["Shops:BatchDisable"]).Value;

    /// <summary>批量操作的确认提示，带上本次实际选中的门店数。</summary>
    private string BatchConfirmText => string.Format(
        (_batchTargetEnabled ? L["Shops:BatchEnableConfirm"] : L["Shops:BatchDisableConfirm"]).Value,
        _selectedIds.Count);

    /// <summary>确认按钮样式：启用用成功色、停用用警示色，与操作方向一致。</summary>
    private string BatchConfirmButtonClass =>
        _batchTargetEnabled ? "btn btn-success" : "btn btn-warning";

    /// <summary>
    /// 初始化：缓存用户的店铺管理权限（服务端各操作另有授权强制校验）。
    /// 列表数据由 DataGrid 的 ReadData 机制在首次渲染时自动加载。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // 服务端新增/批量新增同时要求"店铺管理"与"新增店铺"两项权限，
        // 前端入口必须用同一条件判定，否则仅有新增权限的用户会看到必然 403 的入口。
        _canCreate = await AuthorizationService.IsGrantedAsync(LunchFatePermissions.Shops.Default) &&
            await AuthorizationService.IsGrantedAsync(LunchFatePermissions.Shops.Create);
        _canEdit = await AuthorizationService.IsGrantedAsync(LunchFatePermissions.Shops.Edit);
        _canDelete = await AuthorizationService.IsGrantedAsync(LunchFatePermissions.Shops.Delete);
    }

    /// <summary>
    /// DataGrid 服务端分页读取：翻页、排序时由组件回调，
    /// 调用应用服务完成筛选 → 计数 → 排序 → 分页 → 投影（需求文档 FR-S-01）。
    /// </summary>
    /// <param name="e">DataGrid 读取参数（页码、页大小、排序列）</param>
    private async Task OnDataGridReadAsync(DataGridReadDataEventArgs<ShopDto> e)
    {
        _error = null;
        try
        {
            var input = new ShopSearchInput
            {
                Keyword = _keyword,
                Category = string.IsNullOrWhiteSpace(_filterCategory)
                    ? null
                    : (ShopCategory?)int.Parse(_filterCategory),
                IsEnabled = _filterEnabled switch
                {
                    "true" => true,
                    "false" => false,
                    _ => null
                },
                SkipCount = (Math.Max(e.Page, 1) - 1) * e.PageSize,
                MaxResultCount = e.PageSize,
                Sorting = ResolveSorting(e.Columns)
            };

            var result = await ShopAppService.GetListAsync(input);
            _items = result.Items;
            _total = (int)result.TotalCount;
        }
        catch (Exception ex)
        {
            _items = Array.Empty<ShopDto>();
            _total = 0;
            _error = ToUserMessage(ex);
        }
    }

    /// <summary>
    /// 把 DataGrid 的列排序状态转换为服务端排序表达式（服务端另有白名单校验兜底）。
    /// </summary>
    /// <param name="columns">DataGrid 当前列信息</param>
    /// <returns>形如 "Name desc" 的排序表达式；无排序列时回退为按名称升序</returns>
    private static string ResolveSorting(IEnumerable<DataGridColumnInfo>? columns)
    {
        var sorted = columns?.FirstOrDefault(c => c.SortDirection != SortDirection.Default);

        return sorted == null
            ? nameof(ShopDto.Name)
            : $"{sorted.Field} {(sorted.SortDirection == SortDirection.Descending ? "desc" : "asc")}";
    }

    /// <summary>
    /// 按当前筛选条件让 DataGrid 重新触发服务端读取。
    /// </summary>
    private async Task ReloadAsync()
    {
        if (_grid != null)
        {
            await _grid.Reload();
        }
    }

    /// <summary>
    /// 应用筛选条件：先清空跨页勾选再查询。
    /// 筛选条件变化后旧选择可能已不在结果集中，保留会造成"看不见却被操作"的误解。
    /// </summary>
    private async Task SearchAsync()
    {
        ClearSelection();
        await ReloadAsync();
    }

    /// <summary>
    /// 清空筛选条件并重新加载列表。
    /// </summary>
    private async Task ResetFiltersAsync()
    {
        _keyword = null;
        _filterCategory = "";
        _filterEnabled = "";
        ClearSelection();
        await ReloadAsync();
    }

    /// <summary>
    /// 取分类枚举的本地化显示文本。
    /// </summary>
    /// <param name="category">店铺分类</param>
    /// <returns>本地化后的分类名</returns>
    private string CategoryText(ShopCategory category) => L[$"Enum:ShopCategory.{(int)category}"].Value;

    /// <summary>
    /// 打开新增弹窗并重置表单状态。
    /// </summary>
    private async Task OpenCreateModal()
    {
        _isEdit = false;
        _editingId = Guid.Empty;
        _entity = new CreateUpdateShopDto();
        _formError = null;
        await _formModal!.Show();
    }

    /// <summary>
    /// 打开编辑弹窗并把列表项回填到表单。
    /// </summary>
    /// <param name="item">待编辑的店铺</param>
    private async Task OpenEditModal(ShopDto item)
    {
        _isEdit = true;
        _editingId = item.Id;
        _formError = null;
        _entity = new CreateUpdateShopDto
        {
            Name = item.Name,
            Category = item.Category,
            Address = item.Address,
            Phone = item.Phone,
            AveragePrice = item.AveragePrice,
            Rating = item.Rating,
            Tags = item.Tags,
            Weight = item.Weight,
            IsEnabled = item.IsEnabled,
            Remark = item.Remark
        };
        await _formModal!.Show();
    }

    /// <summary>
    /// 关闭新增/编辑弹窗。
    /// </summary>
    private async Task CloseFormModal() => await _formModal!.Hide();

    /// <summary>
    /// 表单提交：按模式调用新增或更新接口，成功后关闭弹窗并刷新列表。
    /// </summary>
    private async Task SaveAsync()
    {
        _formError = null;
        try
        {
            if (_isEdit)
            {
                await ShopAppService.UpdateAsync(_editingId, _entity);
            }
            else
            {
                await ShopAppService.CreateAsync(_entity);
            }

            await _formModal!.Hide();
            ClearSelection();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _formError = ToUserMessage(ex);
        }
    }

    /// <summary>
    /// 切换店铺启用状态（停用的店铺不进入大转盘，需求文档 FR-S-05）。
    /// </summary>
    /// <param name="item">目标店铺</param>
    private async Task ToggleEnabled(ShopDto item)
    {
        _error = null;
        try
        {
            await ShopAppService.UpdateAsync(item.Id, new CreateUpdateShopDto
            {
                Name = item.Name,
                Category = item.Category,
                Address = item.Address,
                Phone = item.Phone,
                AveragePrice = item.AveragePrice,
                Rating = item.Rating,
                Tags = item.Tags,
                Weight = item.Weight,
                IsEnabled = !item.IsEnabled,
                Remark = item.Remark
            });
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
    }

    /// <summary>
    /// 打开删除二次确认弹窗。
    /// </summary>
    /// <param name="item">待删除的店铺</param>
    private async Task AskDelete(ShopDto item)
    {
        _deletingItem = item;
        await _deleteModal!.Show();
    }

    /// <summary>
    /// 关闭删除确认弹窗。
    /// </summary>
    private async Task CloseDeleteModal() => await _deleteModal!.Hide();

    /// <summary>
    /// 打开店铺地图弹窗；无坐标的店铺不会进入该方法。
    /// </summary>
    /// <param name="item">待查看地图的店铺</param>
    private async Task OpenMapModal(ShopDto item)
    {
        _mapItem = item;
        await _mapModal!.Show();
    }

    /// <summary>关闭店铺地图弹窗。</summary>
    private async Task CloseMapModal()
    {
        await _mapModal!.Hide();
        _mapItem = null;
    }

    /// <summary>
    /// 执行软删除并刷新列表。
    /// </summary>
    private async Task DeleteAsync()
    {
        if (_deletingItem == null)
        {
            return;
        }

        _error = null;
        try
        {
            await ShopAppService.DeleteAsync(_deletingItem.Id);

            // 被删除的门店已不存在，从跨页选择中摘掉它，避免下次批量操作把它计入"未找到"。
            _selectedIds.Remove(_deletingItem.Id);

            await _deleteModal!.Hide();
            _deletingItem = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
    }

    /// <summary>
    /// 判断门店是否已选中（按 Id 跨页判断，翻页不影响已选状态）。
    /// </summary>
    /// <param name="item">列表行对应的门店</param>
    private bool IsSelected(ShopDto item) => _selectedIds.Contains(item.Id);

    /// <summary>
    /// 切换单行门店的选中状态。
    /// </summary>
    /// <param name="item">列表行对应的门店</param>
    private Task ToggleSelectedAsync(ShopDto item)
    {
        if (!_selectedIds.Remove(item.Id))
        {
            _selectedIds.Add(item.Id);
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// 全选或取消全选当前页；跨页已选项不受影响（只操作当前页可见的行）。
    /// </summary>
    /// <param name="args">复选框变更参数</param>
    private Task ToggleSelectPageAsync(ChangeEventArgs args)
    {
        var select = args.Value is true or "true";
        foreach (var item in _items)
        {
            if (select)
            {
                _selectedIds.Add(item.Id);
            }
            else
            {
                _selectedIds.Remove(item.Id);
            }
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// 清空跨页选择并清除上一次的批量操作提示。
    /// </summary>
    private void ClearSelection()
    {
        _selectedIds.Clear();
        _notice = null;
    }

    /// <summary>
    /// "清空选择"按钮的事件处理；按钮未选中任何门店时处于禁用态。
    /// </summary>
    private Task ClearSelectionAsync()
    {
        ClearSelection();
        return Task.CompletedTask;
    }

    /// <summary>
    /// 打开批量启用/停用的二次确认弹窗；无选中门店时不做任何事。
    /// </summary>
    /// <param name="isEnabled">目标启用状态</param>
    private async Task AskBatchSetEnabledAsync(bool isEnabled)
    {
        if (_selectedIds.Count == 0)
        {
            return;
        }

        _batchTargetEnabled = isEnabled;
        _error = null;
        _notice = null;
        await _batchModal!.Show();
    }

    /// <summary>
    /// 关闭批量操作确认弹窗。
    /// </summary>
    private async Task CloseBatchModal() => await _batchModal!.Hide();

    /// <summary>
    /// 提交批量启用/停用：成功后清空选择、刷新列表并回显三类计数。
    /// </summary>
    private async Task BatchSetEnabledAsync()
    {
        if (_selectedIds.Count == 0)
        {
            return;
        }

        _batchBusy = true;
        _error = null;
        _notice = null;

        // 先固化目标状态与标识快照：刷新流程会清空 _selectedIds，回调里再读就晚了。
        var isEnabled = _batchTargetEnabled;
        var ids = _selectedIds.ToList();

        try
        {
            var result = await ShopAppService.BatchSetEnabledAsync(new BatchSetShopsEnabledInput
            {
                Ids = ids,
                IsEnabled = isEnabled
            });

            await _batchModal!.Hide();
            ClearSelection();
            await ReloadAsync();

            _notice = string.Format(
                (isEnabled ? L["Shops:BatchEnabledResult"] : L["Shops:BatchDisabledResult"]).Value,
                result.UpdatedCount,
                result.UnchangedCount,
                result.NotFoundCount);
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
        finally
        {
            _batchBusy = false;
        }
    }
}
