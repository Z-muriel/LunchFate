@page "/"
@attribute [Authorize]
@using System.Globalization
@using System.Linq
@using LunchFate.Permissions
@using LunchFate.Records
@using LunchFate.Shops
@using Volo.Abp.Authorization
@inject IShopAppService ShopAppService
@inject IRecordAppService RecordAppService
@inject NavigationManager NavigationManager
@inherits LunchFateComponentBase

@* 主页 · 午餐大转盘（需求文档 FR-W-01 ~ FR-W-06） *@

<div class="wheel-page">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2 class="wheel-title mb-0">@L["Wheel:Title"]</h2>
            <p class="wheel-subtitle mb-0">@L["Wheel:Subtitle"]</p>
        </div>
        @* FR-M-05：天气组件，服务不可用时自动隐藏 *@
        <WeatherWidget />
    </div>

    @if (_error != null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_loading)
    {
        <div class="wheel-spinner" role="status"></div>
    }
    else if (_shops.Count == 0)
    {
        <div class="wheel-empty">
            <div class="wheel-empty-icon">🍽</div>
            <h4>@L["Wheel:Empty"]</h4>
            <p class="text-muted">@L["Wheel:EmptyHint"]</p>
            @if (_canCreate)
            {
                <button type="button" class="btn btn-primary" @onclick="GoToShops">@L["Wheel:GoToShops"]</button>
            }
        </div>
    }
    else
    {
        <div class="wheel-stage">
            <div class="wheel-pointer">▼</div>
            <div class="wheel"
                 style="background:@WheelBackground; transform:rotate(@RotationText); transition:@_transition;">
                @for (var i = 0; i < _shops.Count; i++)
                {
                    var index = i;
                    <div class="wheel-sector" style="transform:rotate(@SectorAngle(index));">
                        <span class="wheel-label" title="@_shops[index].Name">@_shops[index].Name</span>
                    </div>
                }
            </div>
            <div class="wheel-hub">
                <button type="button"
                        class="wheel-start"
                        disabled="@_spinning"
                        @onclick="StartSpinAsync">
                    @(_spinning ? L["Wheel:Spinning"] : L["Wheel:Start"])
                </button>
            </div>
        </div>
        @if (_temporaryShops.Count > 0)
        {
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-3">
                <span class="small text-muted">@L["Wheel:NearbyCount", _temporaryShops.Count]</span>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        disabled="@_spinning"
                        @onclick="ClearNearbyShops">
                    @L["Wheel:ClearNearby"]
                </button>
            </div>
        }
        @if (_shops.Count > Colors.Length)
        {
            <details class="mt-3">
                <summary>@L["Name"] (@_shops.Count)</summary>
                <ol class="mt-2">
                    @foreach (var shop in _shops)
                    {
                        <li>@shop.Name <span class="text-muted">@shop.Address</span></li>
                    }
                </ol>
            </details>
        }
    }
</div>

@* 附近店铺搜索（地图后端能力前端入口） *@
<NearbyShopSearch AllowTemporaryWheel="true" TemporaryWheelAdded="UseNearbyShopsAsync" />

@* 抽取结果弹窗（需求文档 FR-W-03、FR-W-05） *@
<Modal @ref="@_resultModal" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@L["Wheel:ResultTitle"]</ModalTitle>
            <CloseButton Clicked="CloseResultModal" />
        </ModalHeader>
        <ModalBody>
            @if (_result != null)
            {
                @* FR-M-03：有经纬度时整张餐厅卡片可点击，直接唤起高德导航到该店 *@
                @if (CanNavigate(_result))
                {
                    <a class="result-card result-card-link"
                       href="@GetNavigationUrl(_result)"
                       target="_blank"
                       rel="noopener"
                       title="@L["Wheel:NavigateHint"]">
                        @ResultCardContent
                        <span class="result-card-action">🧭 @L["Wheel:Navigate"]</span>
                    </a>
                }
                else
                {
                    @* 无坐标时降级为纯展示卡片，不提供无效的导航入口 *@
                    <div class="result-card">
                        @ResultCardContent
                        <span class="result-card-hint">@L["Wheel:NoCoordinate"]</span>
                    </div>
                }
            }
        </ModalBody>
        <ModalFooter>
            @* FR-M-03：有经纬度时保留显式"去导航"按钮，跳转高德导航页 *@
            @if (_result != null && CanNavigate(_result))
            {
                <a class="btn btn-outline-success"
                   href="@GetNavigationUrl(_result)"
                   target="_blank"
                   rel="noopener">
                    @L["Wheel:Navigate"]
                </a>
            }
            <a class="btn btn-outline-secondary" href="/records/draws">@L["Records:ViewDraws"]</a>
            <button type="button" class="btn btn-outline-primary" disabled="@_spinning" @onclick="SpinAgainAsync">@L["Wheel:Again"]</button>
            <button type="button" class="btn btn-primary" @onclick="CloseResultModal">@L["Wheel:Confirm"]</button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    /// <summary>转盘动画时长（秒）；结束延迟再加 200ms 以确保过渡完全停稳。</summary>
    private const int SpinSeconds = 5;

    /// <summary>扇区配色环，超过 12 个店铺时循环取色。</summary>
    private static readonly string[] Colors =
    [
        "#ff8a65", "#4fc3f7", "#81c784", "#ba68c8", "#ffd54f", "#4db6ac",
        "#f06292", "#9575cd", "#a1887f", "#64b5f6", "#aed581", "#ff7043"
    ];

    /// <summary>当前转盘的完整展示候选：门店库启用门店在前、附近门店在后。</summary>
    private List<EnabledShopDto> _shops = new();

    /// <summary>门店库启用门店；与附近候选合并前单独保存，用于提交抽取时区分来源。</summary>
    private List<EnabledShopDto> _permanentShops = new();

    /// <summary>已加入的附近候选快照（按 PoiId 去重），不写入门店库。</summary>
    private List<TemporaryShopDto> _temporaryShops = new();

    /// <summary>是否正在加载永久门店。</summary>
    private bool _loading = true;

    /// <summary>加载或抽取失败时展示的本地化错误。</summary>
    private string? _error;

    /// <summary>是否允许从空状态进入店铺管理页新增门店。</summary>
    private bool _canCreate;

    /// <summary>从请求服务端到动画结束期间锁定候选和抽取按钮。</summary>
    private bool _spinning;

    /// <summary>转盘累计旋转角度。</summary>
    private double _rotation;

    /// <summary>动画累计旋转圈数，仅用于展示，不参与选择获胜门店。</summary>
    private int _turns;

    /// <summary>服务端确认已保存抽取记录后返回的获胜门店快照。</summary>
    private EnabledShopDto? _result;

    /// <summary>抽取结果弹窗引用。</summary>
    private Modal? _resultModal;

    /// <summary>
    /// 过渡效果始终生效，保证只有 <c>_rotation</c> 变化时触发旋转动画。
    /// </summary>
    private string _transition =
        $"transform {SpinSeconds}s cubic-bezier(0.15, 0.6, 0.2, 1)";

    /// <summary>
    /// 把累计旋转角格式化为 CSS 的 deg 值。
    /// 固定两位小数并使用不变文化，避免部分区域设置输出逗号小数破坏 CSS。
    /// </summary>
    private string RotationText =>
        _rotation.ToString("F2", CultureInfo.InvariantCulture) + "deg";

    /// <summary>
    /// 按当前启用店铺生成 conic-gradient 扇区背景；无店铺时给出统一灰色占位。
    /// </summary>
    private string WheelBackground
    {
        get
        {
            if (_shops.Count == 0)
            {
                return "conic-gradient(#e9ecef 0deg 360deg)";
            }

            var step = 360.0 / _shops.Count;
            var stops = new List<string>();
            for (var i = 0; i < _shops.Count; i++)
            {
                var from = (i * step).ToString("F2", CultureInfo.InvariantCulture);
                var to = ((i + 1) * step).ToString("F2", CultureInfo.InvariantCulture);
                stops.Add($"{Colors[i % Colors.Length]} {from}deg {to}deg");
            }

            return $"conic-gradient(from 0deg, {string.Join(", ", stops)})";
        }
    }

    /// <summary>
    /// 初始化：加载登录用户的大转盘数据源和空状态新增权限。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadAsync();
    }

    /// <summary>
    /// 检查新增权限并加载已启用店铺作为转盘扇区；失败时展示本地化错误。
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _canCreate = await AuthorizationService.IsGrantedAsync(LunchFatePermissions.Shops.Default) &&
                await AuthorizationService.IsGrantedAsync(LunchFatePermissions.Shops.Create);
            var result = await ShopAppService.GetEnabledListAsync();
            _permanentShops = result.Items.ToList();
            _temporaryShops.Clear();
            RebuildWheel();
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// 追加附近候选到转盘（不替换已有候选），按 PoiId 去重；抽取期间拒绝变更以保持索引稳定。
    /// </summary>
    /// <param name="items">选中的附近 POI</param>
    private Task UseNearbyShopsAsync(IReadOnlyList<NearbyPoiDto> items)
    {
        if (_spinning)
        {
            return Task.CompletedTask;
        }

        var existing = _temporaryShops.Select(shop => shop.PoiId).ToHashSet(StringComparer.Ordinal);
        foreach (var item in items)
        {
            if (string.IsNullOrWhiteSpace(item.Id) || !existing.Add(item.Id!))
            {
                continue;
            }

            _temporaryShops.Add(new TemporaryShopDto
            {
                PoiId = item.Id!,
                Name = item.Name,
                Address = item.Address,
                Longitude = item.Longitude,
                Latitude = item.Latitude
            });
        }

        RebuildWheel();
        _error = null;
        _result = null;
        _rotation = 0;
        _turns = 0;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>清空全部附近候选，转盘回到门店库候选。</summary>
    private void ClearNearbyShops()
    {
        if (_spinning || _temporaryShops.Count == 0)
        {
            return;
        }

        _temporaryShops.Clear();
        RebuildWheel();
        _result = null;
        _rotation = 0;
        _turns = 0;
    }

    /// <summary>
    /// 重建转盘展示候选：门店库启用门店在前、已加入的附近门店在后。
    /// 顺序必须与提交给服务端的候选顺序一致（ShopIds 顺序 + TemporaryShops 顺序），
    /// 否则服务端返回的 WinnerIndex 会对不上扇区。
    /// </summary>
    private void RebuildWheel()
    {
        _shops = _permanentShops
            .Concat(_temporaryShops.Select(item => new EnabledShopDto
            {
                Id = Guid.Empty,
                Name = item.Name,
                Category = ShopCategory.Other,
                AveragePrice = 0,
                Address = item.Address,
                Longitude = item.Longitude,
                Latitude = item.Latitude
            }))
            .ToList();
    }

    /// <summary>
    /// 计算第 index 个扇区中心相对正上方的角度（顺时针，单位 deg）。
    /// </summary>
    /// <param name="index">扇区序号</param>
    /// <returns>扇区中心角，供标签定位使用</returns>
    private string SectorAngle(int index)
    {
        var step = 360.0 / _shops.Count;
        var center = (index + 0.5) * step;
        return center.ToString("F2", CultureInfo.InvariantCulture) + "deg";
    }

    /// <summary>
    /// 取分类枚举的本地化显示文本。
    /// </summary>
    /// <param name="category">店铺分类</param>
    /// <returns>本地化后的分类名</returns>
    private string CategoryText(ShopCategory category) => L[$"Enum:ShopCategory.{(int)category}"].Value;

    /// <summary>
    /// 先锁定候选并请求服务端保存抽取记录，仅用返回的索引驱动动画和快照展示结果。
    /// 指针固定在 0°（正上方），扇区 i 的中心角为 (i + 0.5) * step（顺时针），
    /// 因此需要旋转 360 * n + (360 - 中心角) 度；任何失败均解除锁定并显示本地化错误。
    /// </summary>
    private async Task StartSpinAsync()
    {
        if (_spinning || _shops.Count == 0)
        {
            return;
        }

        _spinning = true;
        _result = null;
        _error = null;
        StateHasChanged();

        try
        {
            // 候选 = 门店库启用门店（按展示顺序） + 附近临时门店（按加入顺序）。
            // 服务端按同一顺序拼接，因此 WinnerIndex 可直接对应到扇区。
            var input = new CreateDrawDto
            {
                ShopIds = _permanentShops.Select(shop => shop.Id).ToList(),
                TemporaryShops = _temporaryShops.ToList()
            };
            var draw = await RecordAppService.DrawAsync(input);
            if (draw.Shop == null || draw.WinnerIndex < 0 || draw.WinnerIndex >= _shops.Count ||
                draw.RecordId == Guid.Empty)
            {
                throw new InvalidOperationException();
            }

            var step = 360.0 / _shops.Count;
            var centerAngle = (draw.WinnerIndex + 0.5) * step;
            _turns += 6;
            _rotation = _turns * 360.0 + (360.0 - centerAngle);
            StateHasChanged();

            await Task.Delay(TimeSpan.FromSeconds(SpinSeconds) + TimeSpan.FromMilliseconds(200));

            _result = draw.Shop;
            StateHasChanged();
            await _resultModal!.Show();
        }
        catch (Exception ex)
        {
            _result = null;
            _error = ToUserMessage(ex);
        }
        finally
        {
            _spinning = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// 关闭结果弹窗后立即重新抽取。
    /// </summary>
    private async Task SpinAgainAsync()
    {
        await _resultModal!.Hide();
        await StartSpinAsync();
    }

    /// <summary>
    /// 关闭结果弹窗。
    /// </summary>
    private async Task CloseResultModal() => await _resultModal!.Hide();

    /// <summary>
    /// 跳转到店铺管理页（用于空数据引导）。
    /// </summary>
    private void GoToShops() => NavigationManager.NavigateTo("/shops");

    /// <summary>
    /// 结果卡片主体（店铺名称、保存提示与分类/人均/地址）。
    /// 抽成片段让"整卡可点击导航"与"无坐标纯展示"两种外壳复用同一套内容，避免重复标记。
    /// </summary>
    private RenderFragment ResultCardContent => @<text>
        <div class="result-card-head">
            <div class="result-card-name">@_result!.Name</div>
            <p class="result-card-saved">@L["Records:Saved"]</p>
        </div>
        <dl class="row mb-0 text-start">
            <dt class="col-4">@L["Wheel:Category"]</dt>
            <dd class="col-8">@CategoryText(_result.Category)</dd>
            <dt class="col-4">@L["Wheel:AveragePrice"]</dt>
            <dd class="col-8">@_result.AveragePrice.ToString("0.##")</dd>
            <dt class="col-4">@L["Wheel:Address"]</dt>
            <dd class="col-8">@(_result.Address ?? "-")</dd>
        </dl>
    </text>;

    /// <summary>
    /// 判断店铺是否具备可导航的 GCJ-02 坐标。
    /// 无坐标时按 FR-M-03 降级策略隐藏导航入口，仅展示地址文本。
    /// </summary>
    /// <param name="shop">抽中的店铺</param>
    /// <returns>经纬度齐全时为 true</returns>
    private static bool CanNavigate(EnabledShopDto shop) =>
        shop.Longitude.HasValue && shop.Latitude.HasValue;

    /// <summary>
    /// 生成高德导航 URI（FR-M-03）：纯前端拼接，无需后端调用，浏览器/高德 App 直接打开导航页。
    /// 格式：https://uri.amap.com/navigation?to=经度,纬度,名称&amp;mode=walk&amp;src=lunchfate&amp;callnative=1
    /// 说明：
    /// 1) 步行参数为 mode=walk（不是 walking），传错会退回默认驾车模式；
    /// 2) callnative=1 让移动端优先唤起高德地图客户端，PC 端则打开网页版导航；
    /// 3) 坐标固定用不变文化格式化，避免逗号小数分隔符的地区把经纬度写坏。
    /// </summary>
    /// <param name="shop">抽中的店铺</param>
    /// <returns>高德导航 URL</returns>
    private static string GetNavigationUrl(EnabledShopDto shop)
    {
        var longitude = shop.Longitude!.Value.ToString("F6", CultureInfo.InvariantCulture);
        var latitude = shop.Latitude!.Value.ToString("F6", CultureInfo.InvariantCulture);
        var name = Uri.EscapeDataString(shop.Name);
        return $"https://uri.amap.com/navigation?to={longitude},{latitude},{name}&mode=walk&src=lunchfate&callnative=1";
    }
}
